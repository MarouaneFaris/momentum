{
    "name": "momentum",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint ./src --ext .ts,.tsx",
        "lint:fix": "eslint --fix ./src",
        "format": "prettier --write ./src eslint.config.js prettier.config.js",
        "format:check": "prettier --check ./src eslint.config.js prettier.config.js",
        "type-check": "tsc -b --noEmit",
        "check": "npm run type-check && npm run lint && npm run format:check"
    },
    "dependencies": {
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router": "^7.15.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^10.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "prettier": "3.8.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.10"
    }
}
