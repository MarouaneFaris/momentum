#!/bin/sh
set -e

export UID=$(id -u)
export GID=$(id -g)
if [ -f .env.local ]; then
    DOCKER_COMP="docker compose --env-file .env --env-file .env.local -f docker/compose.yaml -f docker/compose.override.yaml"
else
    DOCKER_COMP="docker compose --env-file .env -f docker/compose.yaml -f docker/compose.override.yaml"
fi

CYAN='\033[0;36m'
GREEN='\033[0;32m'
NC='\033[0m'

printf "${CYAN}pre-push: PHPStan...${NC}\n"
$DOCKER_COMP exec -T php composer phpstan
printf "${GREEN}pre-push: PHPStan passed.${NC}\n"

printf "${CYAN}pre-push: Doctrine schema validation...${NC}\n"
$DOCKER_COMP exec -T php bin/console doctrine:schema:validate
printf "${GREEN}pre-push: Schema valid.${NC}\n"
