# Shared — committed defaults. Override in .env.local (not committed).

APP_ENV=dev

# Database
MARIADB_USER=app
MARIADB_PASSWORD=!ChangeMe!
MARIADB_DATABASE=app
MARIADB_VERSION=11.8.6
MARIADB_CHARSET=utf8mb4

# Redis
REDIS_PASSWORD=!ChangeMe!
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Ports
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
SERVER_NAME=localhost

# Frontend (VITE_ prefix = exposed to browser via import.meta.env)
VITE_API_URL=https://localhost/api
VITE_MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
FRONTEND_SSL_CERT=/certs/tls.pem
FRONTEND_SSL_KEY=/certs/tls.key

# Dev tooling
XDEBUG_MODE=develop
