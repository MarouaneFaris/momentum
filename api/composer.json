{
    "name": "marouanefaris/momentum",
    "description": "",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "dama/doctrine-test-bundle": "^8.6",
        "doctrine/doctrine-bundle": "^3.2.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.8",
        "nelmio/api-doc-bundle": "^5.11.1",
        "nelmio/cors-bundle": "^2.6.1",
        "sentry/sentry-symfony": "^5.12",
        "symfony/asset": "8.1.*",
        "symfony/browser-kit": "^8.1",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mailtrap-mailer": "8.1.*",
        "symfony/mercure-bundle": "^0.5.0",
        "symfony/messenger": "^8.1.4",
        "symfony/monolog-bundle": "^4.0",
        "symfony/rate-limiter": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/resend-mailer": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1.4",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "^8.1.4",
        "symfony/yaml": "8.1.*",
        "zenstruck/foundry": "^2.11.3"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95.10",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-doctrine": "^2.0.22",
        "phpstan/phpstan-symfony": "^2.0.18",
        "phpunit/phpunit": "^13.3.0",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "zircote/swagger-php": "^6.5.3"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "phpstan": "phpstan analyse --memory-limit=4G",
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": "composer phpstan && composer cs-check"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
